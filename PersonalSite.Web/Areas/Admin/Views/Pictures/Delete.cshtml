@model PersonalSite.Core.Models.Picture
@{
    ViewData["Title"] = "Delete Picture";
}

<h1 class="text-danger">Delete Picture</h1>
<hr />

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this picture?</h4>
    <p>This will also remove it from any gallery or project associations.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Picture Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Source</dt>
                    <dd class="col-sm-8"><small>@Model.Source</small></dd>
                    
                    <dt class="col-sm-4">Project</dt>
                    <dd class="col-sm-8">@(Model.ProjectId.HasValue ? $"Project #{Model.ProjectId}" : "None")</dd>
                </dl>
            </div>
        </div>
        
        <form asp-action="Delete" method="post" class="mt-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Yes, Delete Picture</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
    
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Preview</h5>
            </div>
            <div class="card-body text-center">
                <img src="@Model.Source" alt="Picture" class="img-fluid" style="max-height: 400px;" />
            </div>
        </div>
    </div>
</div>