@model PersonalSite.Core.Models.Picture
@{
    ViewData["Title"] = "Picture Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Picture Details</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">@Model.Id</dd>
                    
                    <dt class="col-sm-4">Source</dt>
                    <dd class="col-sm-8"><small>@Model.Source</small></dd>
                    
                    <dt class="col-sm-4">Project ID</dt>
                    <dd class="col-sm-8">@(Model.ProjectId?.ToString() ?? "None")</dd>
                    
                    <dt class="col-sm-4">Created On</dt>
                    <dd class="col-sm-8">@Model.CreatedOn.ToString("yyyy-MM-dd HH:mm")</dd>
                    
                    <dt class="col-sm-4">Updated On</dt>
                    <dd class="col-sm-8">@Model.UpdatedOn.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Preview</h5>
            </div>
            <div class="card-body text-center">
                <img src="@Model.Source" alt="Picture" class="img-fluid" />
            </div>
        </div>
    </div>
</div>