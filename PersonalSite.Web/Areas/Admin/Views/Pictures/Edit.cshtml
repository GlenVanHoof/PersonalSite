@model PictureEditViewModel
@{
    ViewData["Title"] = "Edit Picture";
}

<h1>Edit Picture</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            
            <div class="mb-3">
                <label asp-for="Source" class="form-label"></label>
                <input asp-for="Source" class="form-control" />
                <span asp-validation-for="Source" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="ProjectId" class="form-label"></label>
                <select asp-for="ProjectId" class="form-select">
                    <option value="">-- None --</option>
                    @foreach (var project in Model.AvailableProjects)
                    {
                        <option value="@project.Id">@project.Slug</option>
                    }
                </select>
                <span asp-validation-for="ProjectId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Current Image</h5>
            </div>
            <div class="card-body text-center">
                <img src="@Model.Source" alt="Current" class="img-fluid" style="max-height: 300px;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}