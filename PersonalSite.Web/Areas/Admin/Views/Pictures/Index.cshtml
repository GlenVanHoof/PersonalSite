@model IEnumerable<PersonalSite.Core.Models.Picture>
@{
    ViewData["Title"] = "Pictures";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Pictures</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Upload Picture
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Preview</th>
                <th>Source</th>
                <th>Project</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.Any() == true)
            {
                @foreach (var picture in Model)
                {
                    <tr>
                        <td>
                            <img src="@picture.Source" alt="Picture" class="img-thumbnail" style="max-width: 80px; max-height: 80px;" />
                        </td>
                        <td>
                            <small>@picture.Source</small>
                        </td>
                        <td>
                            @if (picture.ProjectId.HasValue)
                            {
                                <span class="badge bg-primary">Project #@picture.ProjectId</span>
                            }
                            else
                            {
                                <span class="text-muted">None</span>
                            }
                        </td>
                        <td>@picture.CreatedOn.ToString("yyyy-MM-dd")</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@picture.Id" class="btn btn-sm btn-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@picture.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@picture.Id" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No pictures found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>