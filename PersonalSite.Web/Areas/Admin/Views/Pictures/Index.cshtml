@model IEnumerable<PersonalSite.Core.Models.Picture>
@{
    ViewData["Title"] = "Pictures";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Pictures</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Upload Picture
    </a>
</div>

<div>
    @if (Model?.Any() == true)
    {
        <div class="row row-cols-1 row-cols-sm-2 g-3">
            @foreach (var picture in Model)
            {
                <div class="col">
                    <div class="card">
                        <img src="@picture.Source" class="card-img-top" alt="Picture @picture.Id">
                        <div class="card-body">
                            <h5 class="card-title">ID: @picture.Id - Project: @picture.ProjectId</h5>
                            <div class="card-text">
                                <p>CreatedOn: @picture.CreatedOn</p>
                                <p>UpdatedOn: @picture.UpdatedOn</p>
                            </div>
                        </div>
                        <div class="card-footer d-flex justify-content-center">
                            <div class="btn-group " role="group">
                                <a asp-action="Details" asp-route-id="@picture.Id" class="btn btn-sm btn-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@picture.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@picture.Id" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>No pictures found</p>
    }
</div>

</div>