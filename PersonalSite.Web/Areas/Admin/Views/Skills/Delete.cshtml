@model PersonalSite.Core.Models.Skill

@{
    ViewData["Title"] = "Delete Skill";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="text-danger">Delete Skill</h1>
<hr />

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this skill?</h4>
    <p>This action cannot be undone.</p>
</div>

<div class="card">
    <div class="card-header">
        <h5>@Model.Name.GetValueOrDefault("en", "Skill")</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Name (EN)</dt>
            <dd class="col-sm-9">@Model.Name.GetValueOrDefault("en", "N/A")</dd>
            
            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.Type</dd>
            
            <dt class="col-sm-3">Score</dt>
            <dd class="col-sm-9">@Model.ScoreOutOf100%</dd>
        </dl>
        
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Yes, Delete Skill</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>