@model IEnumerable<PersonalSite.Core.Models.Skill>

@{
    ViewData["Title"] = "Skills";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Skills</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Create New Skill
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name (EN)</th>
                <th>Type</th>
                <th>Score</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.Any() == true)
            {
                @foreach (var skill in Model)
                {
                    <tr>
                        <td>@skill.Name.GetValueOrDefault("en", "No name")</td>
                        <td><span class="badge bg-info">@skill.Type</span></td>
                        <td>
                            <div class="progress" style="min-width: 100px;">
                                <div class="progress-bar" role="progressbar" style="width: @skill.ScoreOutOf100%" aria-valuenow="@skill.ScoreOutOf100" aria-valuemin="0" aria-valuemax="100">
                                    @skill.ScoreOutOf100%
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@skill.Id" class="btn btn-sm btn-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@skill.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@skill.Id" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No skills found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>