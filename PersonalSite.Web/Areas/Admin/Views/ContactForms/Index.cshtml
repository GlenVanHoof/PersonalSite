@model IEnumerable<PersonalSite.Core.Models.Contact>
@{
    ViewData["Title"] = "Contact Forms";
}

<h1>Contact Form Submissions</h1>
<hr />

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Message Preview</th>
                <th>Submitted</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.Any() == true)
            {
                @foreach (var contact in Model)
                {
                    <tr>
                        <td>@contact.FirstName @contact.LastName</td>
                        <td>@contact.Email</td>
                        <td>
                            <small>
                                @if (contact.Message != null && contact.Message.Length > 50)
                                {
                                    @contact.Message.Substring(0, 50)@:...
                                }
                                else
                                {
                                    @contact.Message
                                }
                            </small>
                        </td>
                        <td>@contact.CreatedOn.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@contact.Id" class="btn btn-sm btn-info">View</a>
                                <form asp-action="Delete" asp-route-id="@contact.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this contact form?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No contact form submissions yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>