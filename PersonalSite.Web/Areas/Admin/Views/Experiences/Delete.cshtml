@model PersonalSite.Core.Models.Experience
@{
    ViewData["Title"] = "Delete Experience";
}

<h1 class="text-danger">Delete Experience</h1>
<hr />

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this experience?</h4>
</div>

<div class="card">
    <div class="card-header">
        <h5>@Model.Company.GetValueOrDefault("en", "Experience")</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@Model.Company.GetValueOrDefault("en", "N/A")</dd>
            
            <dt class="col-sm-3">Position</dt>
            <dd class="col-sm-9">@Model.Position.GetValueOrDefault("en", "N/A")</dd>
            
            <dt class="col-sm-3">Period</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("MMM yyyy") - @(Model.EndDate?.ToString("MMM yyyy") ?? "Present")</dd>
        </dl>
        
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Yes, Delete Experience</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>