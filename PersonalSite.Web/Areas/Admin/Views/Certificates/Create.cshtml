@model PersonalSite.Web.Areas.Admin.Models.CertificateEditViewModel

@{
    ViewData["Title"] = "Create Certificate";
}

<h1>Create Certificate</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Basic Information</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Organisation" class="form-label"></label>
                        <input asp-for="Organisation" class="form-control" />
                        <span asp-validation-for="Organisation" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="AcquiredOn" class="form-label"></label>
                        <input asp-for="AcquiredOn" class="form-control" type="date" />
                        <span asp-validation-for="AcquiredOn" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5>Translations</h5>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs" role="tablist">
                        @for (int i = 0; i < Model.Languages.Count; i++)
                        {
                            var lang = Model.Languages[i];
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(i == 0 ? "active" : "")" 
                                        id="@lang.Code-tab" 
                                        data-bs-toggle="tab" 
                                        data-bs-target="#@lang.Code-content" 
                                        type="button" 
                                        role="tab">
                                    @lang.Name (@lang.Code.ToUpper())
                                </button>
                            </li>
                        }
                    </ul>
                    
                    <div class="tab-content pt-3">
                        @for (int i = 0; i < Model.Languages.Count; i++)
                        {
                            <div class="tab-pane fade @(i == 0 ? "show active" : "")" 
                                 id="@Model.Languages[i].Code-content" 
                                 role="tabpanel">
                                
                                <input type="hidden" name="Names[@i].LanguageCode" value="@Model.Languages[i].Code" />
                                <input type="hidden" name="Names[@i].LanguageName" value="@Model.Languages[i].Name" />
                                <div class="mb-3">
                                    <label class="form-label">Certificate Name (@Model.Languages[i].Name) <span class="text-danger">*</span></label>
                                    <input type="text" name="Names[@i].Text" class="form-control" required />
                                </div>
                                
                                <input type="hidden" name="Descriptions[@i].LanguageCode" value="@Model.Languages[i].Code" />
                                <input type="hidden" name="Descriptions[@i].LanguageName" value="@Model.Languages[i].Name" />
                                <div class="mb-3">
                                    <label class="form-label">Description (@Model.Languages[i].Name)</label>
                                    <textarea name="Descriptions[@i].Text" class="form-control" rows="3"></textarea>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Create Certificate</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}