@model PersonalSite.Core.Models.Certificate

@{
    ViewData["Title"] = "Delete Certificate";
}

<div class="alert alert-danger">
    <h1>Delete Certificate</h1>
    <p>Are you sure you want to delete this certificate?</p>
</div>

<div class="card">
    <div class="card-header">
        <h5>Certificate Information</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name.GetValueOrDefault("en", "N/A")</dd>
            
            <dt class="col-sm-3">Organisation</dt>
            <dd class="col-sm-9">@(Model.Organisation ?? "N/A")</dd>
            
            <dt class="col-sm-3">Acquired On</dt>
            <dd class="col-sm-9">@Model.AcquiredOn.ToString("MMMM yyyy")</dd>
        </dl>
        
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Yes, Delete Certificate</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>