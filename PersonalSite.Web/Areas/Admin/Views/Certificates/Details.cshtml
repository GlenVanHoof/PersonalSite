@model PersonalSite.Core.Models.Certificate

@{
    ViewData["Title"] = "Certificate Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Certificate Details</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5>Basic Information</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Organisation</dt>
            <dd class="col-sm-9">@(Model.Organisation ?? "N/A")</dd>
            
            <dt class="col-sm-3">Acquired On</dt>
            <dd class="col-sm-9">@Model.AcquiredOn.ToString("MMMM yyyy")</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5>Translations</h5>
    </div>
    <div class="card-body">
        @{
            var languages = Model.Name.Keys.Union(Model.Description.Keys).Distinct().OrderBy(x => x).ToList();
        }
        <ul class="nav nav-tabs" role="tablist">
            @for (int i = 0; i < languages.Count; i++)
            {
                var lang = languages[i];
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(i == 0 ? "active" : "")"
                            id="@lang-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#@lang-content"
                            type="button"
                            role="tab">
                        @lang.ToUpper()
                    </button>
                </li>
            }
        </ul>
        <div class="tab-content pt-3">
            @for (int i = 0; i < languages.Count; i++)
            {
                var lang = languages[i];
                <div class="tab-pane fade @(i == 0 ? "show active" : "")"
                     id="@lang-content"
                     role="tabpanel">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <div>@(Model.Name.TryGetValue(lang, out var n) ? (string.IsNullOrEmpty(n) ? "N/A" : n) : "N/A")</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <div style="white-space: pre-wrap;">@(Model.Description.TryGetValue(lang, out var d) ? (string.IsNullOrEmpty(d) ? "N/A" : d) : "N/A")</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/translations-tabs.js"></script>
}
