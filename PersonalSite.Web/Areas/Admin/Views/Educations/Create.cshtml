@model EducationEditViewModel
@{
    ViewData["Title"] = "Add Education";
}

<h1>Add Education</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Period</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" class="form-control" type="date" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" class="form-control" type="date" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                            <small class="form-text text-muted">Leave empty if currently studying</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5>Translations</h5>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs" role="tablist">
                        @for (int i = 0; i < Model.Languages.Count; i++)
                        {
                            var lang = Model.Languages[i];
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(i == 0 ? "active" : "")" 
                                        id="@lang.Code-tab" 
                                        data-bs-toggle="tab" 
                                        data-bs-target="#@lang.Code-content" 
                                        type="button" 
                                        role="tab">
                                    @lang.Name (@lang.Code.ToUpper())
                                </button>
                            </li>
                        }
                    </ul>
                    
                    <div class="tab-content pt-3">
                        @for (int i = 0; i < Model.Languages.Count; i++)
                        {
                            var lang = Model.Languages[i];
                            <div class="tab-pane fade @(i == 0 ? "show active" : "")" 
                                 id="@lang.Code-content" 
                                 role="tabpanel">
                                
                                <input type="hidden" name="Institutions[@i].LanguageCode" value="@lang.Code" />
                                <input type="hidden" name="Institutions[@i].LanguageName" value="@lang.Name" />
                                <div class="mb-3">
                                    <label class="form-label">Institution (@lang.Name) <span class="text-danger">*</span></label>
                                    <input type="text" name="Institutions[@i].Text" class="form-control" required />
                                </div>
                                
                                <input type="hidden" name="Degrees[@i].LanguageCode" value="@lang.Code" />
                                <input type="hidden" name="Degrees[@i].LanguageName" value="@lang.Name" />
                                <div class="mb-3">
                                    <label class="form-label">Degree (@lang.Name) <span class="text-danger">*</span></label>
                                    <input type="text" name="Degrees[@i].Text" class="form-control" required />
                                </div>
                                
                                <input type="hidden" name="FieldsOfStudy[@i].LanguageCode" value="@lang.Code" />
                                <input type="hidden" name="FieldsOfStudy[@i].LanguageName" value="@lang.Name" />
                                <div class="mb-3">
                                    <label class="form-label">Field of Study (@lang.Name)</label>
                                    <input type="text" name="FieldsOfStudy[@i].Text" class="form-control" />
                                </div>
                                
                                <input type="hidden" name="Descriptions[@i].LanguageCode" value="@lang.Code" />
                                <input type="hidden" name="Descriptions[@i].LanguageName" value="@lang.Name" />
                                <div class="mb-3">
                                    <label class="form-label">Description (@lang.Name)</label>
                                    <textarea name="Descriptions[@i].Text" class="form-control" rows="5"></textarea>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}