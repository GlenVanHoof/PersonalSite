@model PersonalSite.Web.Areas.Admin.Models.EducationEditViewModel

@{
    ViewData["Title"] = "Edit Education";
}

<h1>Edit Education</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Basic Information</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="StartDate" class="form-label"></label>
                        <input asp-for="StartDate" class="form-control" type="date" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="EndDate" class="form-label"></label>
                        <input asp-for="EndDate" class="form-control" type="date" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5>Translations</h5>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs" role="tablist">
                        @for (int i = 0; i < Model.Languages.Count; i++)
                        {
                            var lang = Model.Languages[i];
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(i == 0 ? "active" : "")" 
                                        id="@lang.Code-tab" 
                                        data-bs-toggle="tab" 
                                        data-bs-target="#@lang.Code-content" 
                                        type="button" 
                                        role="tab">
                                    @lang.Name (@lang.Code.ToUpper())
                                </button>
                            </li>
                        }
                    </ul>
                    
                    <div class="tab-content pt-3">
                        @for (int i = 0; i < Model.Languages.Count; i++)
                        {
                            <div class="tab-pane fade @(i == 0 ? "show active" : "")" 
                                 id="@Model.Languages[i].Code-content" 
                                 role="tabpanel">
                                
                                <input type="hidden" name="Institutions[@i].LanguageCode" value="@Model.Institutions[i].LanguageCode" />
                                <input type="hidden" name="Institutions[@i].LanguageName" value="@Model.Institutions[i].LanguageName" />
                                <div class="mb-3">
                                    <label class="form-label">Institution (@Model.Institutions[i].LanguageName) <span class="text-danger">*</span></label>
                                    <input type="text" name="Institutions[@i].Text" value="@Model.Institutions[i].Text" class="form-control" required />
                                </div>
                                
                                <input type="hidden" name="Degrees[@i].LanguageCode" value="@Model.Degrees[i].LanguageCode" />
                                <input type="hidden" name="Degrees[@i].LanguageName" value="@Model.Degrees[i].LanguageName" />
                                <div class="mb-3">
                                    <label class="form-label">Degree (@Model.Degrees[i].LanguageName) <span class="text-danger">*</span></label>
                                    <input type="text" name="Degrees[@i].Text" value="@Model.Degrees[i].Text" class="form-control" required />
                                </div>
                                
                                <input type="hidden" name="FieldsOfStudy[@i].LanguageCode" value="@Model.FieldsOfStudy[i].LanguageCode" />
                                <input type="hidden" name="FieldsOfStudy[@i].LanguageName" value="@Model.FieldsOfStudy[i].LanguageName" />
                                <div class="mb-3">
                                    <label class="form-label">Field of Study (@Model.FieldsOfStudy[i].LanguageName)</label>
                                    <input type="text" name="FieldsOfStudy[@i].Text" value="@Model.FieldsOfStudy[i].Text" class="form-control" />
                                </div>
                                
                                <input type="hidden" name="Descriptions[@i].LanguageCode" value="@Model.Descriptions[i].LanguageCode" />
                                <input type="hidden" name="Descriptions[@i].LanguageName" value="@Model.Descriptions[i].LanguageName" />
                                <div class="mb-3">
                                    <label class="form-label">Description (@Model.Descriptions[i].LanguageName)</label>
                                    <textarea name="Descriptions[@i].Text" class="form-control" rows="3">@Model.Descriptions[i].Text</textarea>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}