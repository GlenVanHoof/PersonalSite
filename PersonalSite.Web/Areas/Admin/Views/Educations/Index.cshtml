@model IEnumerable<PersonalSite.Core.Models.Education>

@{
    ViewData["Title"] = "Education";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Education</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Add Education
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Institution (EN)</th>
                <th>Degree (EN)</th>
                <th>Field of Study (EN)</th>
                <th>Period</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.Any() == true)
            {
                @foreach (var education in Model)
                {
                    <tr>
                        <td>@education.Institution.GetValueOrDefault("en", "N/A")</td>
                        <td>@education.Degree.GetValueOrDefault("en", "N/A")</td>
                        <td>@(education.FieldOfStudy?.GetValueOrDefault("en", "N/A") ?? "N/A")</td>
                        <td>
                            @education.StartDate.ToString("MMM yyyy") - @(education.EndDate?.ToString("MMM yyyy") ?? "Present")
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@education.Id" class="btn btn-sm btn-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@education.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@education.Id" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No education records found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>