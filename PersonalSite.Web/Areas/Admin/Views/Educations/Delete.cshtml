@model PersonalSite.Core.Models.Education
@{
    ViewData["Title"] = "Delete Education";
}

<h1 class="text-danger">Delete Education</h1>
<hr />

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this education record?</h4>
</div>

<div class="card">
    <div class="card-header">
        <h5>@Model.Institution.GetValueOrDefault("en", "Education")</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Institution</dt>
            <dd class="col-sm-9">@Model.Institution.GetValueOrDefault("en", "N/A")</dd>
            
            <dt class="col-sm-3">Degree</dt>
            <dd class="col-sm-9">@Model.Degree.GetValueOrDefault("en", "N/A")</dd>
            
            <dt class="col-sm-3">Period</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("MMM yyyy") - @(Model.EndDate?.ToString("MMM yyyy") ?? "Present")</dd>
        </dl>
        
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Yes, Delete Education</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>