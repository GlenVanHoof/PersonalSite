@model PersonalSite.Core.Models.User
@{
    ViewData["Title"] = "User Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>User Details</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="ChangePassword" asp-route-id="@Model.Id" class="btn btn-secondary">Change Password</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">
                <h5>Account Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Username</dt>
                    <dd class="col-sm-8">@Model.Username</dd>
                    
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    
                    <dt class="col-sm-4">Role</dt>
                    <dd class="col-sm-8"><span class="badge bg-@(Model.Role == "SuperAdmin" ? "danger" : "primary")">@Model.Role</span></dd>
                    
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">
                <h5>Personal Information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">First Name</dt>
                    <dd class="col-sm-8">@(Model.FirstName ?? "N/A")</dd>
                    
                    <dt class="col-sm-4">Last Name</dt>
                    <dd class="col-sm-8">@(Model.LastName ?? "N/A")</dd>
                    
                    <dt class="col-sm-4">Last Login</dt>
                    <dd class="col-sm-8">@(Model.LastLoginOn?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>