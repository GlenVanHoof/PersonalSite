@model PersonalSite.Core.Models.Contact

@{
    ViewData["Title"] = "Contactbericht Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-envelope-open me-2"></i>Contactbericht Details</h1>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-2"></i>Terug naar lijst
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-person me-2"></i>@Model.FirstName @Model.LastName
                </h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">
                        <i class="bi bi-person me-2"></i>Voornaam
                    </dt>
                    <dd class="col-sm-9">@Model.FirstName</dd>
                    
                    <dt class="col-sm-3">
                        <i class="bi bi-person me-2"></i>Achternaam
                    </dt>
                    <dd class="col-sm-9">@Model.LastName</dd>
                    
                    <dt class="col-sm-3">
                        <i class="bi bi-envelope me-2"></i>Email
                    </dt>
                    <dd class="col-sm-9">
                        <a href="mailto:@Model.Email" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-envelope me-2"></i>@Model.Email
                        </a>
                    </dd>
                    
                    <dt class="col-sm-3">
                        <i class="bi bi-calendar me-2"></i>Ontvangen op
                    </dt>
                    <dd class="col-sm-9">
                        @Model.CreatedAt.ToString("dddd d MMMM yyyy 'om' HH:mm")
                        <br />
                        <small class="text-muted">(@Model.CreatedAt.ToRelativeTime())</small>
                    </dd>
                </dl>
                
                <hr />
                
                <div class="mt-4">
                    <h5 class="mb-3">
                        <i class="bi bi-chat-text me-2"></i>Bericht
                    </h5>
                    <div class="alert alert-light border">
                        <p class="mb-0" style="white-space: pre-wrap;">@Model.Message</p>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                    <i class="bi bi-trash me-2"></i>Verwijderen
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-list me-2"></i>Terug naar lijst
                </a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">
                    <i class="bi bi-info-circle me-2"></i>Snelle Acties
                </h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="mailto:@Model.Email?subject=Re: Uw bericht van @Model.CreatedAt.ToString("dd/MM/yyyy")&body=Beste @Model.FirstName," 
                       class="btn btn-primary">
                        <i class="bi bi-reply me-2"></i>Beantwoord per Email
                    </a>
                    <button type="button" class="btn btn-outline-secondary" onclick="copyToClipboard('@Model.Email')">
                        <i class="bi bi-clipboard me-2"></i>Kopieer Email
                    </button>
                </div>
            </div>
        </div>
        
        <div class="card shadow-sm mt-3">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-info-circle me-2"></i>Bericht Info
                </h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <strong>ID:</strong> @Model.Id
                    </li>
                    <li class="mb-2">
                        <strong>Bericht lengte:</strong> @(Model.Message?.Length ?? 0) karakters
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                alert('Email adres gekopieerd naar klembord!');
            });
        }
    </script>
}