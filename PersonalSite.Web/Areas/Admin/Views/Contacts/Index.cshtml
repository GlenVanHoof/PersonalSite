@model IEnumerable<PersonalSite.Core.Models.Contact>

@{
    ViewData["Title"] = "Contactberichten";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-envelope me-2"></i>Contactberichten</h1>
    <span class="badge bg-primary fs-5">@Model.Count() bericht(en)</span>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>Er zijn nog geen contactberichten ontvangen.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Datum</th>
                    <th>Naam</th>
                    <th>Email</th>
                    <th>Bericht</th>
                    <th style="width: 150px;">Acties</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <small class="text-muted">
                                @item.CreatedAt.ToString("dd/MM/yyyy")<br />
                                @item.CreatedAt.ToString("HH:mm")
                            </small>
                        </td>
                        <td>
                            <strong>@item.FirstName @item.LastName</strong>
                        </td>
                        <td>
                            <a href="mailto:@item.Email" class="text-decoration-none">
                                <i class="bi bi-envelope me-1"></i>@item.Email
                            </a>
                        </td>
                        <td>
                            <span class="text-truncate d-inline-block" style="max-width: 300px;" title="@item.Message">
                                @(item.Message?.Length > 60 ? item.Message.Substring(0, 60) + "..." : item.Message)
                            </span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info" title="Details bekijken">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Verwijderen">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}