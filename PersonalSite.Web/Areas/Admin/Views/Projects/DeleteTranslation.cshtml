@model PersonalSite.Core.Models.ProjectTranslation
@{
    ViewData["Title"] = "Delete Translation";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var project = ViewBag.Project as PersonalSite.Core.Models.Project;
}

<h1>Delete Translation</h1>
<h3>Are you sure you want to delete this translation?</h3>
<h4>For Project: @project?.Slug</h4>
<hr />

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Language)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Language)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Title)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Title)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ShortDescription)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ShortDescription)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.LongDescription)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.LongDescription)</dd>

            <dt class="col-sm-3">Technologies</dt>
            <dd class="col-sm-9">
                @if (Model.Technologies != null && Model.Technologies.Any())
                {
                    <span>@string.Join(", ", Model.Technologies)</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="DeleteTranslation" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Details" asp-route-id="@Model.ProjectId" class="btn btn-secondary">Cancel</a>
</form>