@model PersonalSite.Core.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Project Details</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5>Basic Information</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Slug</dt>
            <dd class="col-sm-9">@Model.Slug</dd>

            <dt class="col-sm-3">GitHub URL</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrEmpty(Model.GithubUrl))
                {
                    <a href="@Model.GithubUrl" target="_blank">@Model.GithubUrl</a>
                }
                else
                {
                    <span>N/A</span>
                }
            </dd>

            <dt class="col-sm-3">Project URL</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrEmpty(Model.ProjectUrl))
                {
                    <a href="@Model.ProjectUrl" target="_blank">@Model.ProjectUrl</a>
                }
                else
                {
                    <span>N/A</span>
                }
            </dd>

            <dt class="col-sm-3">Order Index</dt>
            <dd class="col-sm-9">@Model.OrderIndex</dd>

            <dt class="col-sm-3">Skills</dt>
            <dd class="col-sm-9">
                @if (Model.Skills != null && Model.Skills.Any())
                {
                    <ul class="mb-0">
                        @foreach (var skill in Model.Skills)
                        {
                            <li>@skill.Name.GetValueOrDefault("en", skill.Name.Values.FirstOrDefault() ?? "Unknown")</li>
                        }
                    </ul>
                }
                else
                {
                    <span>N/A</span>
                }
            </dd>

            <dt class="col-sm-3">Created On</dt>
            <dd class="col-sm-9">@Model.CreatedOn.ToString("MMMM dd, yyyy")</dd>

            <dt class="col-sm-3">Updated On</dt>
            <dd class="col-sm-9">@Model.UpdatedOn.ToString("MMMM dd, yyyy")</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5>Images</h5>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div class="mb-3">
                <h6>Card Image</h6>
                <div class="text-center">
                    <img src="@Model.ImagePath" class="img-fluid rounded" style="max-height: 400px; object-fit: contain;" alt="Project card image" />
                </div>
            </div>
        }
        
        @if (Model.Pictures.Any())
        {
            <hr />
            <h6>All Project Images (@Model.Pictures.Count)</h6>
            <div class="row g-3 mt-2">
                @foreach (var picture in Model.Pictures)
                {
                    <div class="col-md-4">
                        <div class="card">
                            <img src="@picture.Source" class="card-img-top" style="height: 200px; object-fit: cover;" alt="Project image" />
                            <div class="card-body p-2">
                                @if (Model.ImagePath == picture.Source)
                                {
                                    <span class="badge bg-primary">Card Image</span>
                                }
                                <small class="text-muted d-block">Added: @picture.CreatedOn.ToString("MMM dd, yyyy")</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No images uploaded for this project.</p>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5>Translations</h5>
    </div>
    <div class="card-body">
        @{
            var languages = Model.Title.Keys.Union(Model.ShortDescription.Keys).Union(Model.Description.Keys).Distinct().OrderBy(x => x).ToList();
        }
        <ul class="nav nav-tabs" role="tablist">
            @for (int i = 0; i < languages.Count; i++)
            {
                var lang = languages[i];
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(i == 0 ? "active" : "")"
                            id="@lang-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#@lang-content"
                            type="button"
                            role="tab">
                        @lang.ToUpper()
                    </button>
                </li>
            }
        </ul>
        <div class="tab-content pt-3">
            @for (int i = 0; i < languages.Count; i++)
            {
                var lang = languages[i];
                <div class="tab-pane fade @(i == 0 ? "show active" : "")"
                     id="@lang-content"
                     role="tabpanel">
                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <div>@(Model.Title.TryGetValue(lang, out var t) ? (string.IsNullOrEmpty(t) ? "N/A" : t) : "N/A")</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Short Description</label>
                        <div>@(Model.ShortDescription.TryGetValue(lang, out var sd) ? (string.IsNullOrEmpty(sd) ? "N/A" : sd) : "N/A")</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <div style="white-space: pre-wrap;">@(Model.Description.TryGetValue(lang, out var d) ? (string.IsNullOrEmpty(d) ? "N/A" : d) : "N/A")</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
