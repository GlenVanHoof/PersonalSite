@model PersonalSite.Web.Areas.Admin.Models.ProjectEditViewModel

@{
    ViewData["Title"] = "Edit Project";
}

<h1>Edit Project</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card mb-3">
        <div class="card-header">
            <h5>Basic Information</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Slug" class="form-label"></label>
                <input asp-for="Slug" class="form-control" />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GithubUrl" class="form-label"></label>
                <input asp-for="GithubUrl" class="form-control" />
                <span asp-validation-for="GithubUrl" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OrderIndex" class="form-label"></label>
                <input asp-for="OrderIndex" class="form-control" type="number" />
                <span asp-validation-for="OrderIndex" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h5>Images</h5>
        </div>
        <div class="card-body">
            @if (Model.ExistingPictures.Any())
            {
                <h6>Existing Images</h6>
                <div class="row g-2 mb-3">
                    @for (int i = 0; i < Model.ExistingPictures.Count; i++)
                    {
                        var picture = Model.ExistingPictures[i];
                        <div class="col-md-3">
                            <div class="card">
                                <img src="@picture.Source" class="card-img-top" style="height: 150px; object-fit: cover;" alt="Project image">
                                <div class="card-body p-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="SelectedCardImagePath" value="@picture.Source" 
                                               @(Model.SelectedCardImagePath == picture.Source ? "checked" : "") />
                                        <label class="form-check-label small">Card image</label>
                                    </div>
                                    <div class="form-check mt-1">
                                        <input class="form-check-input" type="checkbox" name="PicturesToDelete" value="@picture.Id" />
                                        <label class="form-check-label text-danger small">Delete</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="mb-3">
                <label asp-for="UploadedImages" class="form-label">Upload New Images</label>
                <input asp-for="UploadedImages" class="form-control" type="file" accept="image/*" multiple id="imageUpload" />
                <small class="form-text text-muted">Max 20MB each (.jpg, .jpeg, .png, .gif, .webp)</small>
            </div>
            <div id="imagePreview" class="row g-2 mt-2"></div>
        </div>
    </div>

    <!-- Translation sections (same as Create) -->
    @for (int i = 0; i < Model.Languages.Count; i++)
    {
        var language = Model.Languages[i];
        <div class="card mb-3">
            <div class="card-header">
                <h5>@language.Name</h5>
            </div>
            <div class="card-body">
                <input type="hidden" asp-for="Titles[i].LanguageCode" />
                <input type="hidden" asp-for="Titles[i].LanguageName" />
                <input type="hidden" asp-for="Descriptions[i].LanguageCode" />
                <input type="hidden" asp-for="Descriptions[i].LanguageName" />
                <input type="hidden" asp-for="ShortDescriptions[i].LanguageCode" />
                <input type="hidden" asp-for="ShortDescriptions[i].LanguageName" />

                <div class="mb-3">
                    <label asp-for="Titles[i].Text" class="form-label">Title</label>
                    <input asp-for="Titles[i].Text" class="form-control" />
                    <span asp-validation-for="Titles[i].Text" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ShortDescriptions[i].Text" class="form-label">Short Description</label>
                    <textarea asp-for="ShortDescriptions[i].Text" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="ShortDescriptions[i].Text" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descriptions[i].Text" class="form-label">Description</label>
                    <textarea asp-for="Descriptions[i].Text" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Descriptions[i].Text" class="text-danger"></span>
                </div>
            </div>
        </div>
    }

    <div class="mb-3">
        <button type="submit" class="btn btn-warning">Update</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin/image-preview.js"></script>
    <script>
        // Initialize image preview for new uploads
        initializeImagePreview('imageUpload', 'imagePreview');
    </script>
}