@model PersonalSite.Core.Models.Project
@{
    ViewData["Title"] = "Delete Project";
}

<h1 class="text-danger">Delete Project</h1>
<hr />

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this project?</h4>
    <p>This action cannot be undone. All translations will also be deleted.</p>
</div>

<div class="card">
    <div class="card-header">
        <h5>@Model.Title.GetValueOrDefault("en", Model.Slug)</h5>
    </div>
    <div class="card-body">
        <dl class="row">
        <dt class="col-sm-3">Project URL</dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrEmpty(Model.ProjectUrl))
            {
                <a href="@Model.ProjectUrl" target="_blank">@Model.ProjectUrl</a>
            }
            else
            {
                <span>N/A</span>
            }
        </dd>

        <dt class="col-sm-3">Skills</dt>
        <dd class="col-sm-9">
            @if (Model.Skills != null && Model.Skills.Any())
            {
                <ul class="mb-0">
                    @foreach (var skill in Model.Skills)
                    {
                        <li>@skill.Type</li>
                    }
                </ul>
            }
            else
            {
                <span>N/A</span>
            }
        </dd>
        <dt class="col-sm-3">Skills</dt>
        <dd class="col-sm-9">
            @if (Model.Skills != null && Model.Skills.Any())
            {
                <ul class="mb-0">
                    @foreach (var skill in Model.Skills)
                    {
                        <li>@skill.Name.GetValueOrDefault("en", skill.Name.Values.FirstOrDefault() ?? "Unknown")</li>
                    }
                </ul>
            }
            else
            {
                <span>N/A</span>
            }
        </dd>
            <dt class="col-sm-3">Slug</dt>
            <dd class="col-sm-9">@Model.Slug</dd>
            
            <dt class="col-sm-3">Translations</dt>
            <dd class="col-sm-9">@Model.Title.Count language(s)</dd>
            
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <dt class="col-sm-3">Image</dt>
                <dd class="col-sm-9">
                    <img src="@Model.ImagePath" alt="@Model.Slug" class="img-thumbnail" style="max-width: 200px;" />
                </dd>
            }
        </dl>
        
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Yes, Delete Project</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>