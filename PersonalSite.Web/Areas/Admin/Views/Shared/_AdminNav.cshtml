@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
}

<nav id="sidebarMenu" class="col-md-2 col-lg-2 d-md-block bg-light sidebar position-fixed offcanvas-md offcanvas-start" style="height: 100vh; top: 0; left: 0; overflow-y: auto;" tabindex="-1">
    <div class="offcanvas-header d-md-none border-bottom">
        <h5 class="offcanvas-title">Admin Panel</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-md-block p-0">
        <div class="d-none d-md-block p-3 border-bottom">
            <h5 class="mb-0">Admin Panel</h5>
        </div>
        
        <ul class="nav flex-column pt-3">
            <li class="nav-item">
                <a class="nav-link @(currentController == "Home" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentController == "Projects" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Projects" asp-action="Index">
                    <i class="bi bi-folder"></i> Projects
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentController == "Experiences" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Experiences" asp-action="Index">
                    <i class="bi bi-briefcase"></i> Experiences
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentController == "Educations" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Educations" asp-action="Index">
                    <i class="bi bi-mortarboard"></i> Educations
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentController == "Certificates" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Certificates" asp-action="Index">
                    <i class="bi bi-award"></i> Certificates
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentController == "Skills" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Skills" asp-action="Index">
                    <i class="bi bi-gear"></i> Skills
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentController == "Pictures" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Pictures" asp-action="Index">
                    <i class="bi bi-image"></i> Pictures
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentController == "GalleryPictures" ? "active" : "")" 
                   asp-area="Admin" asp-controller="GalleryPictures" asp-action="Index">
                    <i class="bi bi-images"></i> Gallery
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentController == "ContactForms" ? "active" : "")" 
                   asp-area="Admin" asp-controller="ContactForms" asp-action="Index">
                    <i class="bi bi-envelope"></i> Contact Forms
                </a>
            </li>
            @if (User.IsInRole("SuperAdmin"))
            {
                <li class="nav-item mt-3 pt-3 border-top">
                    <a class="nav-link @(currentController == "Users" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Users" asp-action="Index">
                        <i class="bi bi-people"></i> Users
                    </a>
                </li>
            }
        </ul>
        
        <div class="px-3 mt-4 pt-3 border-top">
            <div class="d-flex align-items-center mb-3">
                <i class="bi bi-person-circle me-2 fs-5"></i>
                <small class="text-muted">@User.Identity?.Name</small>
            </div>
            
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm w-100 mb-2">
                <i class="bi bi-globe"></i> Back to Site
            </a>
            
            <form asp-area="Admin" asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </div>
    </div>
</nav>

<!-- Mobile menu toggle button (only visible on small screens) -->
<button class="btn btn-link d-md-none position-fixed" 
        type="button" 
        data-bs-toggle="offcanvas" 
        data-bs-target="#sidebarMenu" 
        aria-controls="sidebarMenu"
        style="top: 10px; left: 10px; z-index: 1000;">
    <i class="bi bi-list fs-3"></i>
</button>