@model IEnumerable<PersonalSite.Core.Models.GalleryPicture>
@{
    ViewData["Title"] = "Gallery Pictures";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Homepage Gallery</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Add to Gallery
    </a>
</div>

<div class="alert alert-info">
    <strong>Note:</strong> Drag and drop rows to reorder the gallery. Lower positions appear first.
</div>

<table class="table">
    <thead>
        <tr>
            <th>Position</th>
            <th>Picture</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Position</td>
            <td>
                <img src="@item.Picture?.Source" alt="Gallery Image" style="max-width:100px;" />
            </td>
            <td>
                <a asp-action="Reorder"
                   asp-route-pictureId="@item.PictureId"
                   asp-route-direction="up"
                   class="btn btn-sm btn-secondary">&#8593; Up</a>
                <a asp-action="Reorder"
                   asp-route-pictureId="@item.PictureId"
                   asp-route-direction="down"
                   class="btn btn-sm btn-secondary">&#8595; Down</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>