@model GalleryPictureEditViewModel
@{
    ViewData["Title"] = "Add to Gallery";
}

<h1>Add Picture to Gallery</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            
            <div class="mb-3">
                <label asp-for="PictureId" class="form-label"></label>
                <select asp-for="PictureId" class="form-select" id="pictureSelect">
                    <option value="">-- Select a picture --</option>
                    @foreach (var picture in Model.AvailablePictures)
                    {
                        <option value="@picture.Id" data-src="@picture.Source">Picture #@picture.Id (@picture.Source)</option>
                    }
                </select>
                <span asp-validation-for="PictureId" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Position" class="form-label"></label>
                <input asp-for="Position" class="form-control" type="number" min="0" />
                <span asp-validation-for="Position" class="text-danger"></span>
                <small class="form-text text-muted">Lower numbers appear first (0, 1, 2...)</small>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Add to Gallery</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
    
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Preview</h5>
            </div>
            <div class="card-body text-center">
                <img id="preview" src="" alt="Preview" class="img-fluid" style="display: none; max-height: 300px;" />
                <p id="noPreview" class="text-muted">Select a picture to preview</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('pictureSelect').addEventListener('change', function(e) {
            var selected = e.target.options[e.target.selectedIndex];
            var preview = document.getElementById('preview');
            var noPreview = document.getElementById('noPreview');
            var src = selected.getAttribute('data-src');
            
            if (src) {
                preview.src = src;
                preview.style.display = 'block';
                noPreview.style.display = 'none';
            } else {
                preview.style.display = 'none';
                noPreview.style.display = 'block';
            }
        });
    </script>
}