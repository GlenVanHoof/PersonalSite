@model PersonalSite.Core.Models.GalleryPicture
@{
    ViewData["Title"] = "Remove from Gallery";
}

<h1 class="text-danger">Remove from Gallery</h1>
<hr />

<div class="alert alert-danger">
    <h4>Are you sure you want to remove this picture from the gallery?</h4>
    <p>The picture itself will not be deleted, only removed from the homepage gallery.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Gallery Position: @Model.Position</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Picture ID</dt>
                    <dd class="col-sm-8">@Model.PictureId</dd>
                    
                    <dt class="col-sm-4">Position</dt>
                    <dd class="col-sm-8">@Model.Position</dd>
                </dl>
            </div>
        </div>
        
        <form asp-action="Delete" method="post" class="mt-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Yes, Remove from Gallery</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
    
    @if (Model.Picture != null)
    {
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Preview</h5>
                </div>
                <div class="card-body text-center">
                    <img src="@Model.Picture.Source" alt="Gallery picture" class="img-fluid" style="max-height: 400px;" />
                </div>
            </div>
        </div>
    }
</div>