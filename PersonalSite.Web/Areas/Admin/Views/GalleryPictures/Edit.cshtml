@model GalleryPictureEditViewModel
@{
    ViewData["Title"] = "Edit Gallery Picture";
}

<h1>Edit Gallery Picture</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5>Select Existing Picture</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="PictureId" class="form-label">Choose Picture</label>
                        <select asp-for="PictureId" class="form-select" id="pictureSelect">
                            <option value="">-- Select Picture --</option>
                            @foreach (var picture in Model.AvailablePictures)
                            {
                                <option value="@picture.Id"
                                        data-src="@picture.Source">
                                    Picture #@picture.Id - @(picture.Source.Remove(0,26))
                                </option>
                            }
                        </select>
                        <span asp-validation-for="PictureId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-save"></i> Update
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Current Image</h5>
            </div>
            <div class="card-body text-center">
                @if (Model.PictureId != null)
                {
                    var currentPicture = Model.AvailablePictures.FirstOrDefault(p => p.Id == Model.PictureId);
                    if (currentPicture != null)
                    {
                        <img src="@currentPicture.Source" alt="Current" class="img-fluid rounded mb-3" style="max-height: 400px;" />
                    }
                    else
                    {
                        <p class="text-muted">No image</p>
                    }
                }
                else
                {
                    <p class="text-muted">No image</p>
                }
            </div>
        </div>
        <div class="card mt-3">
            <div class="card-header">
                <h5>Preview</h5>
            </div>
            <div class="card-body text-center">
                <img id="imagePreview" src="" alt="Preview" class="img-fluid rounded" style="display: none; max-height: 400px;" />
                <p id="noPreview" class="text-muted">
                    <i class="bi bi-image fs-1 d-block mb-2"></i>
                    Select a picture to see preview
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Preview existing picture selection
        document.getElementById('pictureSelect')?.addEventListener('change', function(e) {
            const selectedOption = e.target.options[e.target.selectedIndex];
            const src = selectedOption.getAttribute('data-src');
            if (src) {
                document.getElementById('imagePreview').src = src;
                document.getElementById('imagePreview').style.display = 'block';
                document.getElementById('noPreview').style.display = 'none';
            } else {
                document.getElementById('imagePreview').style.display = 'none';
                document.getElementById('noPreview').style.display = 'block';
            }
        });
    </script>
}