@inject IViewLocalizer Localizer
@model PersonalSite.Web.Models.PortfolioViewModel
@{
    ViewData["Title"] = "Portfolio";
}


<div class="container">
    <div class="text-md-start mb-5">
        <h1 class="display-4 text-center">Portfolio</h1>
        <p class="text-md-center">@Localizer["Portfolio Intro"]</p>
    </div>

    <div class="row g-4">
        @foreach (var project in Model.Projects)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(project.ImagePath))
                    {
                        <img src="@project.ImagePath" class="card-img-top" alt="@project.Title" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary" style="height: 200px;"></div>
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@project.Title</h5>
                        <p class="card-text">@project.ShortDescription</p>
                                                
                        <div class="mt-auto">
                            @if (!string.IsNullOrEmpty(project.GitUrl))
                            {
                                <a href="@project.GitUrl" class="btn btn-outline-primary btn-sm me-2" target="_blank">
                                    <i class="bi bi-github"></i> View Code
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(project.Slug))
                            {
                                <a href="@Url.Action("Details", new { slug = project.Slug })" class="btn btn-primary btn-sm">
                                    View Details
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Projects.Any())
    {
        <div class="alert alert-info">
            No projects found. Add some projects in the admin panel.
        </div>
    }
</div>
