@inject IViewLocalizer Localizer
@model ProjectDetailViewModel

@{
    ViewData["Title"] = @Model.Title;
}

<div class="project-container">
    <div class="text-md-start justify-content-lg-start mb-5 w-75">
        <h1 class="display-4 text-md-start pb-5">@Model.Title</h1>
        <div class="row">
            <!-- Column Left -->
            <div class="col-md-5">
                <div class="card">
                    @if (Model.GithubUrl != null || Model.ProjectUrl != null)
                    {
                        <div class="card-header">
                            @if (Model.GithubUrl != null)
                            {

                                <a class="btn btn-lg btn-outline-primary" href="@Model.GithubUrl">
                                    <i class="bi bi-github"></i> Github
                                </a>
                            }
                            @if (Model.ProjectUrl != null)
                            {
                                <a class="btn btn-lg btn-outline-primary" href="@Model.ProjectUrl">
                                    <i class="bi bi-link-45deg"></i> @Model.Title
                                </a>
                            }
                        </div>
                    }                    
                    @if (Model.Skills != null)
                    {
                        <div class="card-body">
                            <h5 class="card-title">Skills</h5>
                            @foreach (string skill in Model.Skills)
                            {
                                <span class="badge bg-primary fs-5">@skill</span>
                            }
                        </div>
                    }
                    
                </div>
            </div>

            <!-- Column Right -->
            <div class="col-md-7">
                <p class="text-md-start multiline-text">@Model.Description</p>
            </div>
        </div>
        
        
        
        
        
        
        
        
        
        
        
        <p class="text-md-start multiline-text">@Html.Raw(Model.Description)</p>
    </div>

    <h1 class="display-4 text-center">Gallery</h1>
    @if (Model.Pictures.Count > 0)
    {
        <div class="carousel-wrapper">
            <div id="CustomCarousel" class="carousel slide" data-bs-ride="carousel">
            
                <div class="carousel-inner">
                    @foreach (var picture in Model.Pictures)
                    {
                        <div class="carousel-item @(picture == Model.Pictures.First() ? "active" : "")">
                            <img class="d-block w-100" src="@picture" alt="@Model.Title">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#CustomCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>

                <button class="carousel-control-next" type="button" data-bs-target="#CustomCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
}