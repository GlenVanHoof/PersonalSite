@using System.Globalization
@model AboutViewModel
@{
    ViewData["Title"] = "About Me";
}

<div class="container py-5">
    <div class="row">
        <!-- Left Column -->
        <div class="col-md-3">
            <div class="sticky-top about-picture-section">
                <div class="text-center mb-4" style="margin-right: 1em">
                    @if (!string.IsNullOrEmpty(Model.PictureURL))
                    {
                        <img src="~/@Model.PictureURL" alt="Profile Picture" class="img-fluid rounded-circle mb-3 about-picture" />
                    }
                    <h1 class="h3 mb-2">Glen Van Hoof</h1>
                    <p class="text-muted">Full-Stack .NET Developer</p>
                </div>
                
                <!-- Description Section -->
                <div class="pd-1">
                    <p class="text text-end">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            @Model.Description
                        }
                    </p>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-md-7">
            <!-- Skills Section -->
            @if (Model.Skills.Any())
            {
                <div class="mb-5">
                    <h2 class="border-bottom pb-2 mb-4">
                        <i class="bi bi-tools me-2"></i>Skills
                    </h2>
                    
                    @foreach (var group in Model.Skills.Where(s => s.Key == "Technical"))    
                    {
                        <div class="mb-4 card p-4">
                            <h4 class="mb-3">@group.Key</h4>
                            <div class="row">

                                <div class="accordion accordion-flush d-flex flex-wrap" id="accordionFlush">
                                @for (int i = 0 ; i < group.Value.Count; i++)
                                {
                                    var skill = group.Value[i];
                                        string headingId = $"flush-heading{i}";
                                        string collapseId = $"flush-collapse{i}";

                                    <div class="accordion-item col-md-6">
                                        <h2 class="accordion-header" id="@headingId">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                                @skill.Name
                                            </button>
                                        </h2>
                                        <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#accordionFlush">
                                            <div class="accordion-body">
                                                @skill.Description
                                            </div>
                                        </div>
                                    </div>
                                }
                                </div>
                            </div>
                        </div>
                    }
                    
                    @foreach (var group in Model.Skills.Where(s => s.Key != "Technical"))
                    {
                        <div class="mb-4 card p-4">
                            <h4 class="mb-3">@group.Key</h4>
                            <div class="row">
                                @foreach (var skill in group.Value)
                                {
                                    <div class="col-md-4 mb-3">
                                        <div class="d-flex align-items-center">
                                            <div class="flex-grow-1">
                                                <strong>@skill.Name</strong>
                                                <div class="progress" style="height: 8px;">
                                                    <div class="progress-bar" role="progressbar" style="width: @skill.ScoreOutOf100%;"
                                                         aria-valuenow="@skill.ScoreOutOf100" aria-valuemin="0" aria-valuemax="100">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Education Section -->
            @if (Model.Educations.Any())
            {
                <div class="mb-5">
                    <h2 class="border-bottom pb-2 mb-4">
                        <i class="bi bi-mortarboard me-2"></i>Education
                    </h2>
                    @foreach (var education in Model.Educations.OrderByDescending(e => e.StartDate))
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-3">
                                        <small class="text-muted">
                                            @education.StartDate.Year -
                                            @(education.EndDate.HasValue ? education.EndDate.Value.Year.ToString() : "Present")
                                        </small>
                                    </div>
                                    <div class="col-md-9">
                                        <h5 class="card-title">@education.FieldOfStudy - <span class="text-muted">@education.Degree</span></h5>
                                        <h6 class="card-subtitle mb-2 text-muted">@education.Institution</h6>
                                        @if (!string.IsNullOrEmpty(education.Description))
                                        {
                                            <p class="card-text">@education.Description</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Experience Section -->
            @if (Model.Experiences.Any())
            {
                <div class="mb-5">
                    <h2 class="border-bottom pb-2 mb-4">
                        <i class="bi bi-briefcase me-2"></i>Experience
                    </h2>
                    <div class="timeline">
                        @foreach (var experience in Model.Experiences.OrderByDescending(e => e.StartDate))
                        {
                            <div class="card mb-3">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <small class="text-muted">
                                                @experience.StartDate.Year -
                                                @(experience.EndDate.HasValue ? experience.EndDate.Value.Year.ToString() : "Present")
                                            </small>
                                        </div>
                                        <div class="col-md-9">
                                            <h5 class="card-title">@experience.Position</h5>
                                            <h6 class="card-subtitle mb-2 text-muted">@experience.Company</h6>
                                            @if (!string.IsNullOrEmpty(experience.Description))
                                            {
                                                <p class="card-text">@experience.Description</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Certificates Section -->
            @if (Model.Certificates.Any())
            {
                <div class="mb-5">
                    <h2 class="border-bottom pb-2 mb-4">
                        <i class="bi bi-award me-2"></i>Certificates & Achievements
                    </h2>
                    <div class="row">
                        @foreach (var certificate in Model.Certificates.OrderByDescending(c => c.AcquiredOn))
                        {
                            <div class="col-md-6 mb-3">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title">@certificate.Name</h5>
                                        <p class="card-text">
                                            <small class="text-muted">
                                                <strong>Organisation:</strong> @certificate.Organisation<br />
                                                <strong>Date:</strong> @(certificate.AcquiredOn.HasValue ? certificate.AcquiredOn.Value.Year.ToString() : "N/A")
                                            </small>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Download CV Section -->
            <div class="mb-5">
                <h2 class="border-bottom pb-2 mb-4">
                    <i class="bi bi-file-earmark-arrow-down"></i>Download Curriculum Vitae
                </h2>
                <div class="d-flex gap-3">
                    <a href="~/documents/cv-glen-van-hoof-english.pdf" class="btn btn-primary" download>
                        <i class="bi bi-download me-2"></i>Download CV (English)
                    </a>
                    <a href="~/documents/cv-glen-van-hoof-nederlands.pdf" class="btn btn-primary" download>
                        <i class="bi bi-download me-2"></i>Download CV (Nederlands)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>