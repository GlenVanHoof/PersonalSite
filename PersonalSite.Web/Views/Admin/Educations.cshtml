@{
    ViewData["Title"] = "Educations - Admin";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminNav" />

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="pt-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2>Educations</h2>
                    <button class="btn btn-primary">Add New Education</button>
                </div>
                
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Institution</th>
                            <th>Degree</th>
                            <th>Field of Study</th>
                            <th>Year</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6" class="text-center">No educations found</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>