@{
    ViewData["Title"] = "Project Translations - Admin";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminNav" />

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="pt-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2>Project Translations</h2>
                    <button class="btn btn-primary">Add New Translation</button>
                </div>
                
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Project</th>
                            <th>Language</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6" class="text-center">No project translations found</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>