@{
    ViewData["Title"] = "Experiences - Admin";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminNav" />

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="pt-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2>Experiences</h2>
                    <button class="btn btn-primary">Add New Experience</button>
                </div>
                
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Company</th>
                            <th>Position</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6" class="text-center">No experiences found</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>